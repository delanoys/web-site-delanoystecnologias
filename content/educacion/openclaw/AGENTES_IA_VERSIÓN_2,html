<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manual Oficial - Implementación Segura de Agentes IA</title>
    <style>
        /* ============================================================
           RESET Y VARIABLES
           ============================================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #0d6efd;
            --primary-dark: #0a58ca;
            --secondary: #6c757d;
            --success: #198754;
            --warning: #ffc107;
            --danger: #dc3545;
            --info: #0dcaf0;
            --bg: #f8f9fa;
            --card-bg: #ffffff;
            --text: #212529;
            --text-muted: #6c757d;
            --border: #dee2e6;
            --shadow: 0 4px 20px rgba(0,0,0,0.08);
            --radius: 12px;
            --transition: 0.3s ease;
        }

        [data-theme="dark"] {
            --bg: #1a1a2e;
            --card-bg: #16213e;
            --text: #e0e0e0;
            --text-muted: #a0a0a0;
            --border: #2a2a4a;
            --shadow: 0 4px 20px rgba(0,0,0,0.4);
        }

        /* ============================================================
           ESTILOS GENERALES
           ============================================================ */
        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--bg);
            color: var(--text);
            transition: background var(--transition), color var(--transition);
            display: flex;
            min-height: 100vh;
        }

        a {
            color: var(--primary);
            text-decoration: none;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 4px;
        }

        /* ============================================================
           HEADER
           ============================================================ */
        .top-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: var(--card-bg);
            border-bottom: 3px solid var(--primary);
            padding: 10px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            box-shadow: var(--shadow);
        }

        .top-header .logo h1 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--primary);
        }

        .top-header .logo small {
            display: block;
            font-size: 0.6rem;
            color: var(--text-muted);
            letter-spacing: 0.5px;
        }

        .top-header .status {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .top-header .status .badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.65rem;
            font-weight: 600;
            background: var(--success);
            color: #fff;
        }

        .top-header .status .badge.warning {
            background: var(--warning);
            color: #000;
        }

        .top-header .progress-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: conic-gradient(var(--primary) 0deg, var(--border) 0deg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.65rem;
            font-weight: 700;
            color: var(--text);
            position: relative;
        }

        .top-header .progress-circle::after {
            content: '';
            position: absolute;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--card-bg);
        }

        .top-header .progress-circle span {
            position: relative;
            z-index: 1;
        }

        .theme-toggle {
            background: none;
            border: 1px solid var(--border);
            border-radius: 50%;
            width: 34px;
            height: 34px;
            cursor: pointer;
            font-size: 1rem;
            color: var(--text);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .theme-toggle:hover {
            background: var(--border);
        }

        .menu-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: var(--text);
            cursor: pointer;
        }

        /* ============================================================
           SIDEBAR
           ============================================================ */
        .sidebar {
            position: fixed;
            top: 66px;
            left: 0;
            bottom: 0;
            width: 260px;
            background: var(--card-bg);
            border-right: 1px solid var(--border);
            overflow-y: auto;
            padding: 12px 0;
            z-index: 999;
            transition: transform 0.3s ease;
        }

        .sidebar .menu-title {
            padding: 0 20px 10px;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            font-weight: 600;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 20px;
            color: var(--text);
            font-size: 0.8rem;
            transition: var(--transition);
            border-left: 3px solid transparent;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: rgba(13, 110, 253, 0.08);
            border-left-color: var(--primary);
            color: var(--primary);
        }

        .sidebar a .phase-badge {
            font-size: 0.55rem;
            background: var(--border);
            padding: 1px 8px;
            border-radius: 10px;
            margin-left: auto;
            color: var(--text-muted);
        }

        .sidebar a .phase-badge.done {
            background: var(--success);
            color: #fff;
        }

        .sidebar a .phase-badge.active {
            background: var(--primary);
            color: #fff;
        }

        /* ============================================================
           MAIN CONTENT
           ============================================================ */
        .main-content {
            margin-left: 260px;
            margin-top: 66px;
            padding: 24px 32px 60px;
            flex: 1;
            max-width: calc(100% - 260px);
        }

        .section {
            scroll-margin-top: 80px;
            margin-bottom: 40px;
        }

        .section h2 {
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section h2 .phase-number {
            font-size: 0.9rem;
            background: var(--primary);
            color: #fff;
            padding: 2px 14px;
            border-radius: 20px;
        }

        .section .subtitle {
            color: var(--text-muted);
            margin-bottom: 20px;
            font-size: 1rem;
        }

        /* ============================================================
           CARDS
           ============================================================ */
        .card {
            background: var(--card-bg);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 18px 22px;
            margin-bottom: 16px;
            border: 1px solid var(--border);
            transition: background var(--transition), border var(--transition);
        }

        .card h3 {
            font-size: 1.05rem;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .card .card-meta {
            font-size: 0.75rem;
            color: var(--text-muted);
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 10px;
        }

        .card .card-meta .tag {
            background: var(--border);
            padding: 2px 10px;
            border-radius: 12px;
        }

        .card .card-meta .tag.difficulty {
            background: var(--warning);
            color: #000;
        }

        .card .card-meta .tag.difficulty.hard {
            background: var(--danger);
            color: #fff;
        }

        /* ============================================================
           TIPS
           ============================================================ */
        .tip {
            border-left: 4px solid var(--primary);
            background: rgba(13, 110, 253, 0.05);
            padding: 14px 18px;
            border-radius: 0 var(--radius) var(--radius) 0;
            margin: 10px 0;
        }

        .tip.warning {
            border-left-color: var(--warning);
            background: rgba(255, 193, 7, 0.05);
        }

        .tip.danger {
            border-left-color: var(--danger);
            background: rgba(220, 53, 69, 0.05);
        }

        .tip.success {
            border-left-color: var(--success);
            background: rgba(25, 135, 84, 0.05);
        }

        .tip strong {
            display: block;
            margin-bottom: 4px;
        }

        /* ============================================================
           CHECKLIST
           ============================================================ */
        .checklist {
            list-style: none;
            padding: 0;
        }

        .checklist li {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 0;
            border-bottom: 1px solid var(--border);
            font-size: 0.85rem;
        }

        .checklist li:last-child {
            border-bottom: none;
        }

        .checklist li input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: var(--primary);
            cursor: pointer;
            flex-shrink: 0;
        }

        /* ============================================================
           KANBAN
           ============================================================ */
        .kanban {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 12px;
            margin-top: 12px;
        }

        .kanban-column {
            background: var(--bg);
            border-radius: var(--radius);
            padding: 10px;
            border: 1px solid var(--border);
            min-height: 120px;
        }

        .kanban-column h4 {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            margin-bottom: 6px;
            text-align: center;
        }

        .kanban-item {
            background: var(--card-bg);
            padding: 6px 10px;
            border-radius: 6px;
            margin-bottom: 4px;
            font-size: 0.75rem;
            border: 1px solid var(--border);
            cursor: pointer;
            transition: var(--transition);
        }

        .kanban-item:hover {
            border-color: var(--primary);
        }

        /* ============================================================
           ROADMAP
           ============================================================ */
        .roadmap {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-top: 10px;
        }

        .roadmap-item {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .roadmap-item .bar {
            flex: 1;
            height: 6px;
            background: var(--border);
            border-radius: 4px;
            overflow: hidden;
        }

        .roadmap-item .bar .fill {
            height: 100%;
            border-radius: 4px;
            background: var(--primary);
            transition: width 0.6s ease;
        }

        .roadmap-item .label {
            font-size: 0.8rem;
            min-width: 100px;
        }

        .roadmap-item .percent {
            font-size: 0.75rem;
            font-weight: 600;
            min-width: 36px;
            text-align: right;
        }

        /* ============================================================
           BITÁCORA
           ============================================================ */
        .bitacora-entry {
            border-bottom: 1px solid var(--border);
            padding: 10px 0;
        }

        .bitacora-entry:last-child {
            border-bottom: none;
        }

        .bitacora-entry .date {
            font-weight: 600;
            color: var(--primary);
            font-size: 0.85rem;
        }

        .bitacora-entry .detail {
            display: flex;
            flex-wrap: wrap;
            gap: 6px 14px;
            margin-top: 4px;
            font-size: 0.85rem;
        }

        /* ============================================================
           DIAGRAMAS
           ============================================================ */
        .diagram-container {
            background: var(--card-bg);
            border-radius: var(--radius);
            padding: 16px;
            border: 1px solid var(--border);
            overflow-x: auto;
            margin: 12px 0;
        }

        .diagram-container svg {
            max-width: 100%;
            height: auto;
        }

        /* ============================================================
           MATRIZ DE RIESGOS
           ============================================================ */
        .risk-matrix {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 10px;
        }

        .risk-item {
            padding: 10px 14px;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            font-size: 0.8rem;
        }

        .risk-item .risk-level {
            font-weight: 700;
        }

        .risk-item .risk-level.low {
            color: var(--success);
        }

        .risk-item .risk-level.medium {
            color: var(--warning);
        }

        .risk-item .risk-level.high {
            color: var(--danger);
        }

        .risk-item .risk-level.critical {
            color: #8b0000;
        }

        /* ============================================================
           CONSTITUCIÓN
           ============================================================ */
        .constitution-article {
            padding: 10px 16px;
            border-bottom: 1px solid var(--border);
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }

        .constitution-article:last-child {
            border-bottom: none;
        }

        .constitution-article .number {
            font-weight: 700;
            color: var(--primary);
            min-width: 30px;
            font-size: 0.9rem;
        }

        .constitution-article .text {
            font-size: 0.9rem;
        }

        /* ============================================================
           TABLAS
           ============================================================ */
        .table-responsive {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }

        table th,
        table td {
            padding: 8px 10px;
            text-align: left;
            border-bottom: 1px solid var(--border);
        }

        table th {
            background: var(--bg);
            font-weight: 600;
        }

        /* ============================================================
           ESTADÍSTICAS
           ============================================================ */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 12px;
            margin: 12px 0;
        }

        .stats-grid .stat {
            background: var(--card-bg);
            border-radius: var(--radius);
            padding: 12px;
            text-align: center;
            border: 1px solid var(--border);
        }

        .stats-grid .stat .number {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--primary);
        }

        .stats-grid .stat .label {
            font-size: 0.65rem;
            color: var(--text-muted);
        }

        /* ============================================================
           TIMELINE
           ============================================================ */
        .timeline-interactive {
            position: relative;
            padding-left: 24px;
            margin: 12px 0;
        }

        .timeline-interactive::before {
            content: '';
            position: absolute;
            left: 6px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: var(--border);
        }

        .timeline-interactive .tl-item {
            position: relative;
            margin-bottom: 12px;
            padding-left: 16px;
        }

        .timeline-interactive .tl-item::before {
            content: '';
            position: absolute;
            left: -20px;
            top: 6px;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: var(--card-bg);
            border: 3px solid var(--primary);
        }

        .timeline-interactive .tl-item.completed::before {
            background: var(--success);
            border-color: var(--success);
        }

        .timeline-interactive .tl-item.active::before {
            background: var(--primary);
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.2);
        }

        .timeline-interactive .tl-item .tl-title {
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
        }

        .timeline-interactive .tl-item .tl-content {
            display: none;
            margin-top: 6px;
            padding-left: 10px;
            border-left: 2px solid var(--border);
            font-size: 0.85rem;
        }

        .timeline-interactive .tl-item.open .tl-content {
            display: block;
        }

        /* ============================================================
           BOTONES
           ============================================================ */
        .btn {
            padding: 6px 16px;
            border-radius: 6px;
            border: none;
            font-weight: 500;
            cursor: pointer;
            transition: var(--transition);
            font-size: 0.8rem;
        }

        .btn-primary {
            background: var(--primary);
            color: #fff;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
        }

        .btn-outline {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text);
        }

        .btn-outline:hover {
            background: var(--border);
        }

        /* ============================================================
           UTILIDADES
           ============================================================ */
        .mt-8 { margin-top: 8px; }
        .mt-16 { margin-top: 16px; }
        .mt-24 { margin-top: 24px; }
        .mb-8 { margin-bottom: 8px; }
        .mb-16 { margin-bottom: 16px; }
        .gap-8 { gap: 8px; }
        .gap-16 { gap: 16px; }
        .flex { display: flex; }
        .flex-wrap { flex-wrap: wrap; }
        .align-center { align-items: center; }
        .justify-between { justify-content: space-between; }
        .text-center { text-align: center; }
        .text-muted { color: var(--text-muted); }
        .text-sm { font-size: 0.85rem; }
        .text-xs { font-size: 0.65rem; }

        .status-badge {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 0.65rem;
            font-weight: 600;
        }

        .status-badge.done { background: var(--success); color: #fff; }
        .status-badge.in-progress { background: var(--warning); color: #000; }
        .status-badge.pending { background: var(--secondary); color: #fff; }
        .status-badge.blocked { background: var(--danger); color: #fff; }

        .footer {
            margin-top: 32px;
            padding-top: 16px;
            border-top: 1px solid var(--border);
            text-align: center;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .footer a {
            color: var(--primary);
        }

        /* ============================================================
           RESPONSIVE
           ============================================================ */
        @media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
                width: 280px;
            }
            .sidebar.open {
                transform: translateX(0);
            }
            .main-content {
                margin-left: 0;
                max-width: 100%;
                padding: 16px;
            }
            .menu-toggle {
                display: flex !important;
            }
            .kanban {
                grid-template-columns: 1fr 1fr;
            }
            .risk-matrix {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {
            .kanban {
                grid-template-columns: 1fr;
            }
            .top-header .logo h1 {
                font-size: 0.9rem;
            }
            .top-header .status .badge {
                font-size: 0.55rem;
                padding: 2px 8px;
            }
            .section h2 {
                font-size: 1.2rem;
            }
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .fade-in {
            animation: fadeIn 0.5s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.6; }
            100% { opacity: 1; }
        }

        .pulse {
            animation: pulse 2s infinite;
        }
    </style>
</head>
