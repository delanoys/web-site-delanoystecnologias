    <script>
        (function() {
            'use strict';

            // ============================================================
            // TEMA OSCURO
            // ============================================================
            const themeToggle = document.getElementById('themeToggle');
            const currentTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', currentTheme);
            themeToggle.textContent = currentTheme === 'dark' ? '☀️' : '🌙';

            themeToggle.addEventListener('click', function() {
                const current = document.documentElement.getAttribute('data-theme');
                const next = current === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                localStorage.setItem('theme', next);
                themeToggle.textContent = next === 'dark' ? '☀️' : '🌙';
            });

            // ============================================================
            // MENÚ LATERAL
            // ============================================================
            const menuToggle = document.getElementById('menuToggle');
            const sidebar = document.getElementById('sidebar');

            menuToggle.addEventListener('click', function() {
                sidebar.classList.toggle('open');
            });

            document.querySelectorAll('.sidebar a').forEach(function(link) {
                link.addEventListener('click', function() {
                    if (window.innerWidth <= 992) {
                        sidebar.classList.remove('open');
                    }
                });
            });

            // ============================================================
            // SCROLL SPY
            // ============================================================
            const sections = document.querySelectorAll('section[id]');
            const navLinks = document.querySelectorAll('.sidebar a');

            function updateActiveLink() {
                let current = '';
                sections.forEach(function(section) {
                    const rect = section.getBoundingClientRect();
                    if (rect.top <= 100) {
                        current = section.getAttribute('id');
                    }
                });

                navLinks.forEach(function(link) {
                    link.classList.remove('active');
                    if (link.getAttribute('href') === '#' + current) {
                        link.classList.add('active');
                    }
                });
            }

            window.addEventListener('scroll', updateActiveLink);

            // ============================================================
            // ROADMAP
            // ============================================================
            const fases = [
                { label: 'Planeación', progress: 100 },
                { label: 'Gobierno Agentes', progress: 100 },
                { label: 'Docker', progress: 100 },
                { label: 'Laboratorio Seguro', progress: 30 },
                { label: 'Git', progress: 0 },
                { label: 'VS Code', progress: 0 },
                { label: 'OpenClaw', progress: 10 },
                { label: 'Skills', progress: 0 },
                { label: 'Rules', progress: 0 },
                { label: 'Prompt Eng', progress: 0 },
                { label: 'MCP', progress: 0 },
                { label: 'Pipeline IA', progress: 0 },
                { label: 'Automatización', progress: 0 },
                { label: 'Consola IA', progress: 0 },
                { label: 'Laboratorio VPS', progress: 0 },
                { label: 'Preproducción', progress: 0 },
                { label: 'Producción', progress: 0 },
                { label: 'Mejora', progress: 0 }
            ];

            const roadmapContainer = document.getElementById('roadmapContainer');
            fases.forEach(function(f) {
                const item = document.createElement('div');
                item.className = 'roadmap-item';
                item.innerHTML = `
                    <span class="label">${f.label}</span>
                    <div class="bar"><div class="fill" style="width: ${f.progress}%; background: ${f.progress === 100 ? 'var(--success)' : 'var(--primary)'};"></div></div>
                    <span class="percent">${f.progress}%</span>
                `;
                roadmapContainer.appendChild(item);
            });

            // ============================================================
            // BITÁCORA
            // ============================================================
            window.agregarEntrada = function() {
                const container = document.getElementById('bitacoraContainer');
                const date = new Date().toISOString().slice(0, 10);
                const entry = document.createElement('div');
                entry.className = 'bitacora-entry';
                entry.innerHTML = `
                    <div class="date">${date}</div>
                    <div class="detail">
                        <span><strong>Objetivo:</strong> <input type="text" placeholder="Objetivo" style="border: none; background: transparent; border-bottom: 1px solid var(--border); width: 160px;"></span>
                        <span><strong>Cambios:</strong> <input type="text" placeholder="Cambios" style="border: none; background: transparent; border-bottom: 1px solid var(--border); width: 160px;"></span>
                        <span><strong>Problemas:</strong> <input type="text" placeholder="Problemas" style="border: none; background: transparent; border-bottom: 1px solid var(--border); width: 160px;"></span>
                        <span><strong>Lecciones:</strong> <input type="text" placeholder="Lecciones" style="border: none; background: transparent; border-bottom: 1px solid var(--border); width: 160px;"></span>
                        <span><strong>Próxima:</strong> <input type="text" placeholder="Próxima sesión" style="border: none; background: transparent; border-bottom: 1px solid var(--border); width: 160px;"></span>
                    </div>
                `;
                container.appendChild(entry);
            };

            // ============================================================
            // PROGRESO GLOBAL
            // ============================================================
            const totalFases = fases.length;
            const completadas = fases.filter(f => f.progress === 100).length;
            const activas = fases.filter(f => f.progress > 0 && f.progress < 100).length;
            const progresoGlobal = Math.round((completadas / totalFases) * 100);

            document.getElementById('totalFases').textContent = totalFases;
            document.getElementById('fasesCompletadas').textContent = completadas;
            document.getElementById('fasesActivas').textContent = activas;
            document.getElementById('progresoGlobal').textContent = progresoGlobal;
            document.getElementById('progressPercent').textContent = progresoGlobal + '%';
            document.getElementById('progressCircle').style.background =
                `conic-gradient(var(--primary) ${progresoGlobal * 3.6}deg, var(--border) ${progresoGlobal * 3.6}deg)`;

            document.getElementById('footerYear').textContent = new Date().getFullYear();

        })();
    </script>
